# ---------------------------------------------------------------------------
# Package Risk Analyzer -- Backend environment variables
# Copy to .env for local (non-Docker) development. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- MongoDB ---
# External managed MongoDB (e.g. MongoDB Atlas). Package Risk Analyzer does
# not provision or manage the MongoDB server itself -- see README "Database".
MONGODB_URI=mongodb://localhost:27017/package-risk-analyzer

# --- Redis (BullMQ broker + cache) ---
REDIS_URL=redis://localhost:6379

# --- GitHub App ---
# See README "GitHub App Setup" for exactly how to create these.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key. Paste with literal \n line breaks (single line) or base64-encode it --
# both forms are accepted, see src/config/env.ts.
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- Security intelligence providers ---
OSV_API_URL=https://api.osv.dev
NPM_REGISTRY_URL=https://registry.npmjs.org
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Package Risk Analyzer <notifications@example.com>

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Misc ---
LOG_LEVEL=info
